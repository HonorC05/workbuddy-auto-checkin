[Unit]
Description=WorkBuddy 全自动积分守护（每日 08:00 全量 + 每 2h 巡逻）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 把下面的路径改成你实际的克隆目录（例如 /opt/workbuddy-auto 或 ~/workbuddy-auto-checkin）
WorkingDirectory=/opt/workbuddy-auto
ExecStart=/usr/bin/python3 /opt/workbuddy-auto/workbuddy_auto.py daemon
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
